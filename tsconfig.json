{
  "compilerOptions": {
    "outDir": "./dist",
    "moduleResolution": "node",
    "allowJs": false,
    "paths": {
      "@/*": ["./src/*"],
    },

    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
